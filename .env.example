# --- Storage -----------------------------------------------------------------
# Leave both unset to use the local JSON file in data/ (fine for development).
# Set both to store submissions in Supabase — see supabase/schema.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Moderation --------------------------------------------------------------
# Required to open /admin and to list or change pending submissions.
# Generate one with: openssl rand -base64 32
OPENMAT_ADMIN_KEY=

# Set to 1 to publish submissions immediately instead of queueing them.
OPENMAT_AUTO_APPROVE=

# --- Sponsor enquiries -------------------------------------------------------
# Without a key, enquiries are still stored — they just aren't emailed.
RESEND_API_KEY=
SPONSOR_TO_EMAIL=sponsor@narigroup.net
# Must be a sender on a domain verified in Resend.
SPONSOR_FROM_EMAIL=

# --- Geocoding ---------------------------------------------------------------
# Nominatim asks for a contact address in the User-Agent of API callers.
OPENMAT_CONTACT_EMAIL=
